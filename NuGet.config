<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Hosts Microsoft.AITools.BinlogMcp (consumed by `mcp-binlog-tool` in
         plugins/dotnet-dnceng/plugin.json). Anonymously resolvable. -->
    <add key="dnceng-public-dotnet-tools"
         value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
</configuration>
