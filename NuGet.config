<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Hosts lewing.helix.mcp and lewing.maestro.mcp (consumed by the `hlx` server in
         plugins/dotnet-helix/plugin.json and the `maestro` server in
         plugins/dotnet-codeflow/plugin.json). The `binlog` server in
         plugins/dotnet-binlog/plugin.json pins Microsoft.AITools.BinlogMcp to the dnceng
         dotnet-public feed explicitly, so it does not depend on this source. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
